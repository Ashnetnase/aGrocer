{
  "manifest_version": 3,
  "name": "Agrocer New World Trolley",
  "version": "0.1.1",
  "description": "Adds user-approved Agrocer products to a visible New World trolley. Never checks out or pays.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.newworld.co.nz/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Agrocer trolley", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://home.ashnetbase.org/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["agrocer-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.newworld.co.nz/*"],
      "js": ["newworld-trolley.js"],
      "run_at": "document_idle"
    }
  ]
}
