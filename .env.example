# Supabase (ADR-013). Copy to .env.local and fill in from the Supabase dashboard.
# .env.local is gitignored — never commit real credentials.
#
# Project: agrocer (ref ojlzjjvrtnslcxqdmpay, ap-southeast-2)

# Session pooler connection string, used by Drizzle migrations and server-side queries.
# Dashboard → Project Settings → Database → Connection string → Session pooler.
# Use the pooler, not the direct connection: src/db/client.ts sets prepare: false for it.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Dashboard → Project Settings → API Keys.
SUPABASE_URL="https://<project-ref>.supabase.co"

# Browser-safe. Only ever used with RLS enabled — which it is not yet, so it is
# unused for now. See TASKS.md.
SUPABASE_PUBLISHABLE_KEY=""

# Server-only. Bypasses RLS — must never be referenced from a client component.
SUPABASE_SECRET_KEY=""

# Used to verify Supabase Auth JWTs once authentication lands.
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# The household the server scopes every query to, created by `npm run db:seed`, which
# prints the id. A single-household stand-in until Supabase Auth lands.
AGROCER_HOUSEHOLD_ID=""

# Set to "1" to make the shopping list read and write Postgres through /api/shopping.
# Unset, the whole app stays on Stage 1 localStorage and needs no database.
NEXT_PUBLIC_AGROCER_SERVER_SHOPPING=""
