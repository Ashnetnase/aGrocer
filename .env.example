# Supabase (ADR-013). Copy to .env.local and fill in from the Supabase dashboard.
# .env.local is gitignored — never commit real credentials.
#
# Project: agrocer (ref ojlzjjvrtnslcxqdmpay, ap-southeast-2)

# Session pooler connection string, used by Drizzle migrations and server-side queries.
# Dashboard → Project Settings → Database → Connection string → Session pooler.
# Use the pooler, not the direct connection: src/db/client.ts sets prepare: false for it.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Dashboard → Project Settings → API Keys.
SUPABASE_URL="https://<project-ref>.supabase.co"

# Public by design — it is meant to ship in browser bundles. Nothing in this repository
# uses it except `npm run db:rls`, which probes with it to prove RLS is holding.
# RLS is enabled on all 9 tables (ADR-016/017), and anon has no policy, so this key reads nothing.
SUPABASE_PUBLISHABLE_KEY=""

# Server-only. Bypasses RLS — must never be referenced from a client component.
SUPABASE_SECRET_KEY=""

# Supabase Auth JWKS endpoint.
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# --- Authentication (ADR-017) -------------------------------------------------
# The browser needs these at runtime to sign in, so they are NEXT_PUBLIC_ by necessity.
# Same values as SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY above; the publishable key is
# public by design and RLS (ADR-016) is what keeps it harmless.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Authentication is ENFORCED unless this is exactly "off". It fails closed on purpose:
# a security control that defaults to off is how the RLS gap happened. Set it to "off"
# only for local work against a database without signing in — every request then warns,
# every route handler is open, and AGROCER_HOUSEHOLD_ID below is used instead.
AGROCER_AUTH=""

# The household the server scopes every query to when AGROCER_AUTH="off". With auth on,
# the household comes from the signed-in user's household_members row instead, and this
# is ignored. `npm run db:seed` prints the id; `npm run db:claim` links an account.
AGROCER_HOUSEHOLD_ID=""

# Set to "1" to make the converted features (shopping, pantry) read and write Postgres
# through their route handlers. Unset, the whole app stays on Stage 1 localStorage and
# needs no database.
NEXT_PUBLIC_AGROCER_SERVER_DATA=""

# The AI provider AshHome talks to. Only "ollama" is implemented (Phase 8); a cloud
# fallback would be added in src/ai/provider.ts, never in a feature. Defaults to "ollama".
AI_PROVIDER="ollama"

# Local Ollama, used by `npm run ai:check`, `npm run ai:chat` and the /api/ai/chat route.
# Development defaults to localhost. Deployment follows ADR-020: the workstation may bind Ollama
# to the LAN only with TCP 11434 firewalled to the Agrocer host's source address.
# Server-only — never expose these to the browser, they describe the home network.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:8b"
